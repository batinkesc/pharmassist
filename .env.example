# PharmAssist .env Şablonu
# Gerçek değerleri .env dosyasına yaz, .env GITIGNORE'da.

# ---------------------------------------------------------------------------
# LLM Provider (RAG yanıt modeli)
# ---------------------------------------------------------------------------
LLM_PROVIDER=claude                          # "claude" | "local"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Together AI / OpenAI-Compat Endpoint (LM_STUDIO_* isimleri legacy)
# ---------------------------------------------------------------------------
LM_STUDIO_URL=https://api.together.xyz/v1
LM_STUDIO_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput
LM_STUDIO_API_KEY=
LLM_MIN_INTERVAL_SEC=1.0

# ---------------------------------------------------------------------------
# RAGAS Değerlendirici Modeller
# ---------------------------------------------------------------------------
RAGAS_PROVIDER=local                         # "local" (Together AI) | "haiku" | "model_b"
RAGAS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput     # Primer evaluator (A)

# Task 3: Cross-Evaluator Agreement — sekonder evaluator (B)
# Önerilenler (Together AI):
#   openai/gpt-oss-120b              ← önerilen ($0.15/$0.60, GPT-style mimari, JSON güvenilir)
#   meta-llama/Llama-3.3-70B-Instruct-Turbo  (alternatif, ~$0.88 blended)
#   deepseek-ai/DeepSeek-V3-1        (denendi ama JSON parse hatası verdi)
RAGAS_MODEL_2=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Veritabanları
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharmassist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/pharmassist

NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=kub_chunks

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
