# PharmAssist environment template
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# LLM Provider (RAG answer model)
# ---------------------------------------------------------------------------
LLM_PROVIDER=claude                          # "claude" | "local"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# OpenAI-compatible endpoint (Together AI, LM Studio, etc.)
# Variable names use the LM_STUDIO_ prefix for legacy reasons.
# ---------------------------------------------------------------------------
LM_STUDIO_URL=https://api.together.xyz/v1
LM_STUDIO_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput
LM_STUDIO_API_KEY=
LLM_MIN_INTERVAL_SEC=1.0

# ---------------------------------------------------------------------------
# RAGAS evaluator models
# ---------------------------------------------------------------------------
RAGAS_PROVIDER=local                         # "local" (OpenAI-compatible) | "haiku"
RAGAS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput
# Secondary evaluator for cross-evaluator agreement (optional)
RAGAS_MODEL_2=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=kub_chunks

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Optional: if set, /api/v1/query requires this value in the X-API-Key header
PHARMASSIST_API_KEY=

# CORS — restrict in production, e.g. ALLOWED_ORIGINS=https://app.example.com
# ALLOWED_ORIGINS=*
