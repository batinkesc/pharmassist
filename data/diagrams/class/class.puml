@startuml PharmAssist_Class
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "src/core" {
  class DrugIdentity {
    +canonical_id: str
    +normalized_name: str
    +inn: str
    +atc_kodu: str
    +from_parsed(): DrugIdentity
    +matches_query(query): bool
  }

  class NameResolver {
    -registry: dict[str, DrugIdentity]
    +resolve(query): list[DrugIdentity]
    +resolve_one(query): DrugIdentity
    +resolve_inn_group(inn): list[DrugIdentity]
    +get_resolver(): NameResolver
  }

  class ContentPolicy {
    +max_chunks: int
    +max_chunk_chars: int
    +max_contraindications: int
    +max_interactions: int
  }
}

package "src/agents" {
  class PatientProfile {
    +yas: int
    +gfr: float
    +karaciger_skoru: str
    +mevcut_ilaclar: list
    +lab_degerleri: dict
    +bobrek_yetmezligi(): bool
    +aktif_flags(): list[str]
    +ozet_metin(): str
  }

  class QueryAugmentor {
    +soru_turleri: list[str]
    +oncelikli_maddeler: list[str]
    +augment(soru, profil): AugmentedQuery
    -_classify(soru): list[str]
    -_prioritize_sections(): list[str]
    -_enrich_query(): str
  }

  class RAGEngine {
    +run_rag(soru, profil): RAGResponse
    -_retrieve_chunks(): list[RetrievedChunk]
    -_answer_calibration_label(chunks): str
    -_build_user_prompt(): str
    -_call_claude(): str
    -_call_local_llm(): str
    ' --- VALIDATE Pipeline (6 adım) ---
    -_validate_guvenli(yanit): str
    -_validate_kontraendikasyon(yanit, chunks, soru): str
    -_tag_unverifiable_sentences(yanit, chunks): str
    -_validate_numeric_claims(yanit, chunks): str
    -_validate_cyp_direction(yanit, chunks): str
    -_enforce_verdict_alignment(yanit, chunks, soru): str
  }
}

package "src/retrieval" {
  class ChromaStore {
    +collection_name: str
    +search(query, filter, k): list
    +get_or_create_collection(): Collection
  }
}

package "src/graph" {
  class GraphRetriever {
    +drug_contraindications(adlar): list
    +drug_interactions(adlar): list
    +get_combined_context(adlar): str
  }
}

package "src/analysis" {
  class CumulativeRiskAnalyzer {
    +analiz_et(ilaclar): KumulatifRiskSonucu
    -_kategorize(ilac): list[str]
  }

  class CYP450Mapper {
    +analiz_et(ilaclar, kub_icerik): CYP450Sonucu
    -_ilac_cyp_profili_bul(ilac): dict
  }
}

package "src/pipeline" {
  class IngestionPipeline {
    +ingest(pdf_path): IngestionResult
    +ingest_all(directory): list[IngestionResult]
    -_write_chromadb(): void
    -_write_neo4j_base(): void
    -_write_interactions_neo4j(): void
    -_retroactive_resolve(): int
  }
}

' İlişkiler
NameResolver --> DrugIdentity : registry
IngestionPipeline --> DrugIdentity : creates
IngestionPipeline --> ContentPolicy : uses
IngestionPipeline --> NameResolver : resolves

RAGEngine --> QueryAugmentor : augments query
RAGEngine --> ChromaStore : retrieves chunks
RAGEngine --> GraphRetriever : fetches relations
RAGEngine --> CumulativeRiskAnalyzer : computes risk
RAGEngine --> CYP450Mapper : maps enzymes
RAGEngine --> ContentPolicy : limits context
RAGEngine --> PatientProfile : uses profile

QueryAugmentor --> PatientProfile : reads
GraphRetriever --> NameResolver : resolves names

@enduml
